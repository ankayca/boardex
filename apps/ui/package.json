{
  "name": "@boardex/ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Boardex React UI (BIBLE §7). Placeholder shell only until Sprint 1.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "verify:prodbundle": "vite build && if ls dist/assets 2>/dev/null | grep -q DesignGalleryPage || grep -rq DesignGalleryPage dist/assets 2>/dev/null; then echo 'PROD BUNDLE LEAK: DesignGalleryPage present in dist/assets' && exit 1; else echo 'prod bundle clean: no DesignGalleryPage chunk or reference'; fi",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@boardex/contract": "*",
    "@fontsource/inter": "^5.0.18",
    "@fontsource/jetbrains-mono": "^5.0.19",
    "@tanstack/react-query": "^5.51.0",
    "@tanstack/react-virtual": "^3.10.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@boardex/mock-runner": "*",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "jsdom": "^26.0.0",
    "postcss": "^8.4.41",
    "tailwindcss": "^3.4.10",
    "vite": "^6.0.0",
    "vitest": "^3.2.7",
    "ws": "^8.21.0"
  }
}
