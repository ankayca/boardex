{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Boardex event stream",
  "description": "Event envelope and complete MVP event catalog for boardex-contract/0.1 (BIBLE §5.1-5.2). Validate a single event against #/definitions/Event. seq is monotonic per run, starts at 1, no gaps; events are immutable and append-only.",
  "$ref": "#/definitions/Event",
  "definitions": {
    "Id": {
      "type": "string",
      "description": "String ULID identifier (format not enforced)"
    },
    "IsoDateTime": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp"
    },
    "RunStatus": {
      "type": "string",
      "enum": [
        "draft",
        "planning",
        "plan_ready",
        "running",
        "awaiting_approval",
        "diagnosing",
        "completed",
        "failed",
        "stopped"
      ]
    },
    "RiskLevel": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "StepKind": {
      "type": "string",
      "enum": [
        "understand_context",
        "edit_code",
        "build",
        "flash",
        "capture",
        "read_serial",
        "evaluate",
        "diagnose",
        "report"
      ]
    },
    "StepStatus": {
      "type": "string",
      "enum": [
        "pending",
        "active",
        "succeeded",
        "failed",
        "skipped"
      ]
    },
    "PlanStep": {
      "type": "object",
      "properties": {
        "index": {
          "type": "integer"
        },
        "title": {
          "type": "string"
        },
        "detail": {
          "type": "string"
        },
        "riskLevel": {
          "$ref": "#/definitions/RiskLevel"
        },
        "hardwareAction": {
          "type": "boolean"
        }
      },
      "required": [
        "index",
        "title",
        "detail",
        "riskLevel",
        "hardwareAction"
      ],
      "additionalProperties": false
    },
    "Run": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/definitions/Id"
        },
        "title": {
          "type": "string"
        },
        "taskPrompt": {
          "type": "string"
        },
        "boardProfileId": {
          "$ref": "#/definitions/Id"
        },
        "status": {
          "$ref": "#/definitions/RunStatus"
        },
        "plan": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/PlanStep"
          }
        },
        "createdAt": {
          "$ref": "#/definitions/IsoDateTime"
        },
        "updatedAt": {
          "$ref": "#/definitions/IsoDateTime"
        },
        "iteration": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "id",
        "title",
        "taskPrompt",
        "boardProfileId",
        "status",
        "createdAt",
        "updatedAt",
        "iteration"
      ],
      "additionalProperties": false
    },
    "RunStep": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/definitions/Id"
        },
        "runId": {
          "$ref": "#/definitions/Id"
        },
        "planIndex": {
          "type": "integer"
        },
        "kind": {
          "$ref": "#/definitions/StepKind"
        },
        "status": {
          "$ref": "#/definitions/StepStatus"
        },
        "title": {
          "type": "string"
        },
        "startedAt": {
          "$ref": "#/definitions/IsoDateTime",
          "description": "ISO 8601 timestamp"
        },
        "endedAt": {
          "$ref": "#/definitions/IsoDateTime",
          "description": "ISO 8601 timestamp"
        },
        "summary": {
          "type": "string"
        },
        "artifactIds": {
          "type": "array",
          "items": {
