        "id",
        "name",
        "mcu",
        "repoPath",
        "buildCommand",
        "flashCommand",
        "resetCommand",
        "serial",
        "instruments",
        "safety",
        "connectionChecklist",
        "knownQuirks"
      ],
      "additionalProperties": false
