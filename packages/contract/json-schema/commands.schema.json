{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Boardex command API",
  "description": "Request/response schemas for the boardex-contract/0.1 HTTP command API (BIBLE §5.3). Routes: GET /health -> HealthResponse; GET /bench -> GetBenchResponse; GET /board-profiles -> ListBoardProfilesResponse; POST /board-profiles: SaveBoardProfileRequest -> SaveBoardProfileResponse; GET /runs -> ListRunsResponse; POST /runs: CreateRunRequest -> CreateRunResponse; POST /runs/{id}/plan/approve: ApprovePlanRequest -> 204; POST /runs/{id}/approvals/{aid}: ResolveApprovalRequest -> 204; POST /runs/{id}/stop: StopRunRequest -> 204; GET /runs/{id}/events?afterSeq=N (GetRunEventsQuery) -> GetRunEventsResponse; GET /artifacts/{id} -> raw content per artifact.mimeType; GET /artifacts/{id}/meta -> GetArtifactMetaResponse. Invalid-for-state commands answer HTTP 409 with ConflictError.",
  "definitions": {
    "Id": {
      "type": "string",
      "description": "String ULID identifier (format not enforced)"
    },
    "IsoDateTime": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp (offset, Z, or naive/local)"
    },
    "RunStatus": {
      "type": "string",
      "enum": [
        "draft",
        "planning",
        "plan_ready",
        "running",
        "awaiting_approval",
        "diagnosing",
        "completed",
        "failed",
        "stopped"
      ]
    },
    "RiskLevel": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "StepKind": {
      "type": "string",
      "enum": [
        "understand_context",
        "edit_code",
        "build",
        "flash",
        "capture",
        "read_serial",
        "evaluate",
        "diagnose",
        "report"
      ]
    },
    "StepStatus": {
      "type": "string",
      "enum": [
        "pending",
        "active",
        "succeeded",
        "failed",
        "skipped"
      ]
    },
    "PlanStep": {
      "type": "object",
      "properties": {
        "index": {
          "type": "integer"
        },
        "title": {
          "type": "string"
        },
        "detail": {
          "type": "string"
        },
        "riskLevel": {
          "$ref": "#/definitions/RiskLevel"
        },
        "hardwareAction": {
          "type": "boolean"
        }
      },
      "required": [
        "index",
        "title",
        "detail",
        "riskLevel",
        "hardwareAction"
      ],
      "additionalProperties": false
    },
    "Run": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/definitions/Id"
        },
        "title": {
          "type": "string"
        },
        "taskPrompt": {
          "type": "string"
        },
        "boardProfileId": {
          "$ref": "#/definitions/Id"
