      "properties": {
        "id": {
          "$ref": "#/definitions/Id"
        },
        "runId": {
          "$ref": "#/definitions/Id"
        },
        "requirementId": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "measurement": {
          "type": "string"
        },
        "expected": {
          "type": "object",
          "properties": {
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            },
            "equals": {
              "type": [
                "boolean",
                "string"
              ]
            },
            "pattern": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "actual": {
          "type": "object",
          "properties": {
            "value": {
              "type": [
                "number",
                "boolean",
                "string"
              ]
            },
            "unit": {
              "type": "string"
            }
          },
          "required": [
            "value"
          ],
          "additionalProperties": false
        },
        "verdict": {
          "type": "string",
          "enum": [
            "pass",
            "fail",
            "needs_review"
          ]
        },
        "artifactId": {
          "$ref": "#/definitions/Id"
        },
        "sourceRef": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "runId",
        "requirementId",
        "description",
        "measurement",
        "expected",
        "actual",
        "verdict",
        "artifactId"
      ],
      "additionalProperties": false
    },
    "Approval": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/definitions/Id"
        },
        "runId": {
          "$ref": "#/definitions/Id"
        },
