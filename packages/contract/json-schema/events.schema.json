        },
        "contractVersion": {
          "type": "string"
        },
        "devices": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "debug_probe",
                  "serial",
                  "logic_analyzer"
                ]
              },
              "name": {
                "type": "string"
              },
              "state": {
                "type": "string",
                "enum": [
                  "online",
                  "offline",
                  "error"
                ]
              },
              "detail": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "kind",
              "name",
              "state"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "runnerOnline",
        "contractVersion",
        "devices"
      ],
      "additionalProperties": false
