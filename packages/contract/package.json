{
  "name": "@boardex/contract",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "The Boardex contract: Zod schemas, inferred types, reducer (BIBLE §4-5). Zero runtime deps besides zod.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.scripts.json",
    "test": "vitest run",
    "build:json-schema": "tsx scripts/build-json-schema.ts"
  },
  "dependencies": {
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "vitest": "^3.2.7",
    "zod-to-json-schema": "^3.25.2"
  }
}
