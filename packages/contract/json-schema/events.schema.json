        "runId",
        "planIndex",
        "kind",
        "status",
        "title",
        "artifactIds"
      ],
      "additionalProperties": false
    },
    "Artifact": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/definitions/Id"
        },
        "runId": {
          "$ref": "#/definitions/Id"
        },
        "stepId": {
          "$ref": "#/definitions/Id"
        },
        "kind": {
          "type": "string",
          "enum": [
            "serial_log",
            "build_log",
            "flash_log",
            "logic_capture",
            "protocol_decode",
            "code_diff",
            "timing_measurement",
            "report_md"
