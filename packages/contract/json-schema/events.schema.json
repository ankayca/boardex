        "runId": {
          "$ref": "#/definitions/Id"
        },
        "failedCheckIds": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Id"
          }
        },
        "hypotheses": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "cause": {
                "type": "string"
              },
              "evidence": {
                "type": "string"
              },
              "confidence": {
                "type": "string",
                "enum": [
                  "high",
                  "moderate",
                  "low"
                ]
              }
            },
            "required": [
              "cause",
              "evidence",
              "confidence"
            ],
            "additionalProperties": false
          }
        },
        "proposedFix": {
          "type": "object",
          "properties": {
            "summary": {
              "type": "string"
            },
            "riskLevel": {
              "$ref": "#/definitions/RiskLevel"
            },
            "filesChanged": {
              "type": "array",
