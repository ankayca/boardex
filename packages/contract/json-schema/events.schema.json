            "filesChanged": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "hardwareActions": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "title",
            "reason",
            "riskLevel",
            "filesChanged",
            "hardwareActions"
          ],
          "additionalProperties": false
        },
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "approved",
            "rejected"
          ]
        },
        "resolvedAt": {
